---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import GuitarCard from '../../components/GuitarCard.astro';
import GuitarGallery from '../../components/GuitarGallery.astro';
import { site } from '../../data/site';
import { signatures } from '../../data/signatures';
import { countByModel, guitars, moreFromModel, priceLabel, type Guitar } from '../../lib/inventory';
import { getPhotos } from '../../lib/photos';

export const getStaticPaths = (() =>
  guitars.map((guitar) => ({ params: { id: guitar.slug }, props: { guitar } }))) satisfies GetStaticPaths;

type Props = { guitar: Guitar };
const { guitar } = Astro.props;
const { id, model } = guitar;
const name = `Dimo ${id}`;
const photos = getPhotos(id);
const more = moreFromModel(guitar);
const modelHref = `/store?model=${model.code}`;

const available = guitar.status === 'available';
const sold = guitar.status === 'sold';
const onReverb = available && Boolean(guitar.reverbUrl);
const storeComing = available && !onReverb;

type Action = { label: string; href: string; external?: boolean; subject?: string };
const actions: Action[] = [];
if (onReverb) actions.push({ label: 'Buy on Reverb', href: guitar.reverbUrl, external: true });
else if (available) actions.push({ label: 'Join the mailing list', href: site.newsletterUrl, external: true });
if (sold) actions.push({ label: 'Ask about a similar instrument', href: '#contact', subject: `Instrument similar to ${id}` });
else actions.push({ label: 'Ask Dimo a question', href: '#contact', subject: `Question about ${name}` });

const details = [
  { label: 'Model', value: model.fullName },
  { label: 'Number', value: id },
  { label: 'Price', value: priceLabel(guitar) },
  ...guitar.specs,
];

const features = signatures.map((s) => ({ label: s.title, href: `/about#${s.anchor}` }));
---

<BaseLayout
  title={`${name} | Handmade Electric Guitar | ${site.name}`}
  description={`${name}, a one of a kind ${model.fullName} handmade electric guitar, built by Dimo in his New York workshop. ${priceLabel(guitar)}.`}
  ogImage={photos[0].image?.src}>
  <nav aria-label="Breadcrumb" class="container-site pt-[22px] text-[13px] text-muted">
    <ol class="flex flex-wrap gap-1.5">
      <li><a href="/store" class="text-muted underline underline-offset-2">Store</a> <span aria-hidden="true">/</span></li>
      <li>
        <a href={modelHref} class="text-muted underline underline-offset-2">{model.fullName}</a>{' '}
        <span aria-hidden="true">/</span>
      </li>
      <li aria-current="page">{id}</li>
    </ol>
  </nav>

  <section class="container-site flex flex-wrap items-start gap-14 pt-7 pb-[72px]">
    <div class="min-w-0 flex-[999_1_560px]">
      <GuitarGallery photos={photos} name={name} />
    </div>

    <div class="flex min-w-0 flex-[1_1_380px] flex-col gap-[22px]">
      <div>
        <p class="label mb-1.5">{model.fullName} · Handmade electric guitar</p>
        <h1 class="font-serif text-[clamp(48px,5vw,64px)] leading-none font-normal">No. {id}</h1>
      </div>

      <div class="flex flex-wrap items-baseline gap-4">
        <p class:list={['text-[26px] font-medium', sold && 'text-muted']}>{priceLabel(guitar)}</p>
        {available && <p class="text-[14px] font-medium text-[#2F5D3A]">● Available · one of a kind</p>}
        {guitar.status === 'hold' && <p class="text-[14px] font-medium text-muted">● On hold</p>}
      </div>

      {
        guitar.notes ? (
          <p class="text-walnut">{guitar.notes}</p>
        ) : (
          <p class="text-muted italic">Description coming soon.</p>
        )
      }

      <div class="flex flex-col gap-2.5">
        {
          storeComing && (
            <p class="mb-1 border-l-2 border-brass pl-4 text-[15px] text-walnut">
              Our online store is coming soon. Join the mailing list to be notified when this guitar is available for
              purchase.
            </p>
          )
        }
        {
          actions.map((a, i) => (
            <a
              href={a.href}
              class:list={['btn min-h-[52px] text-[16px]', i === 0 ? 'btn-primary' : 'btn-secondary']}
              data-contact-subject={a.subject}
              {...(a.external ? { target: '_blank', rel: 'noopener' } : {})}>
              {a.label}
            </a>
          ))
        }
        {
          onReverb && (
            <p class="mt-0.5 text-[13px] text-muted">
              Checkout, payment and insured shipping are handled through our Reverb shop.
            </p>
          )
        }
      </div>

      <div
        class="mx-1 my-3 flex flex-col gap-1 border border-brass bg-[#FBF9F5] px-6 py-[22px] text-center outline outline-1 outline-offset-4 outline-brass">
        <p class="font-serif text-[22px] italic">Dimo Guitars</p>
        <p class="text-[11px] uppercase tracking-[0.22em] text-muted">{site.location}</p>
        <p class="mt-1.5 font-serif text-[20px]">No. {id}</p>
        <p class="font-serif text-[18px] text-walnut italic">Made by hand by Dimo</p>
      </div>

      <div>
        <h2 class="mb-2.5 font-serif text-[26px] font-medium">The instrument</h2>
        <dl class="grid grid-cols-2 border-t border-rule text-[15px]">
          {
            details.map((d) => (
              <>
                <dt class="border-b border-rule py-2.5 text-muted">{d.label}</dt>
                <dd class="border-b border-rule py-2.5">{d.value}</dd>
              </>
            ))
          }
        </dl>
        {
          guitar.specs.length === 0 && (
            <p class="mt-3 text-[14px] text-muted italic">Full specifications coming soon.</p>
          )
        }
      </div>

      <div>
        <h2 class="mb-2.5 font-serif text-[26px] font-medium">Signature features</h2>
        <ul class="flex flex-col gap-2 text-[15px]">
          {
            features.map((f) => (
              <li>
                <a href={f.href} class="underline underline-offset-2">
                  {f.label} →
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  {
    more.length > 0 && (
      <section class="container-site pt-[72px] pb-[88px]">
        <div class="mb-8 flex flex-wrap items-end justify-between gap-6">
          <h2 class="font-serif text-[clamp(36px,4vw,44px)] leading-[1.1] font-normal">More from the {model.code} series</h2>
          <a href={modelHref} class="text-link">
            All {countByModel(model.code)} {model.fullName} guitars →
          </a>
        </div>
        <ul class="grid grid-cols-2 gap-x-4 gap-y-10 sm:gap-x-7 lg:grid-cols-4">
          {more.map((g) => (
            <li>
              <GuitarCard guitar={g} sizes="(min-width: 1240px) 270px, (min-width: 1024px) 25vw, 50vw" />
            </li>
          ))}
        </ul>
      </section>
    )
  }
</BaseLayout>
