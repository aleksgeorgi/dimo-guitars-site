---
import BaseLayout from '../layouts/BaseLayout.astro';
import GuitarPhoto from '../components/GuitarPhoto.astro';
import { site } from '../data/site';
import { signatures } from '../data/signatures';
import { getPhoto } from '../lib/photos';
import { inline, philosophy } from '../lib/philosophy';

const { title, tagline, intro, closing } = philosophy;

const sections = signatures.map((s, i) => ({
  ...s,
  ...philosophy.signatures[i],
  photo: getPhoto(site.aboutGuitarId, s.angle),
  // "The asymmetric neck joint expresses..." reads as "I. The neck joint / expresses..."
  meaning: closing.elements[i].replace(/^The .*?\b(neck joint|maple top|headstock)\s+/i, ''),
}));

const backgrounds = ['border-t border-rule', 'bg-sawdust', ''];
---

<BaseLayout
  title={`Our Philosophy | ${site.name}`}
  description="The philosophy of making Dimo guitars: the classical violin-making tradition, natural wood and three signature elements, built by hand in New York."
  ogImage={getPhoto(site.aboutGuitarId, 'front').image?.src}>
  <section
    class="mx-auto flex max-w-[820px] flex-col items-center gap-[22px] px-[clamp(20px,4vw,48px)] pt-[clamp(64px,8vw,120px)] pb-[clamp(48px,6vw,80px)] text-center">
    <p class="label">Our philosophy</p>
    <h1 class="font-serif text-[clamp(44px,5.4vw,76px)] leading-[1.04] font-normal">{title}</h1>
    {tagline && <p class="font-serif text-[clamp(22px,2.4vw,30px)] text-walnut italic">{tagline}</p>}
    <span class="my-2 block h-px w-16 bg-brass" aria-hidden="true"></span>
    <div class="flex max-w-[36em] flex-col gap-[18px] text-left text-[18px] text-walnut">
      {intro.map((p) => <p set:html={inline(p)} />)}
    </div>
  </section>

  {
    sections.map((s, i) => (
      <section id={s.anchor} class:list={['scroll-mt-4', backgrounds[i]]} aria-labelledby={`${s.anchor}-title`}>
        <div
          class:list={[
            'container-site flex items-center gap-16 py-[clamp(56px,7vw,104px)]',
            i % 2 === 1 ? 'flex-wrap-reverse' : 'flex-wrap',
          ]}>
          {i % 2 === 0 && (
            <div
              class:list={[
                'mx-auto min-w-0',
                s.anchor === 'headstock' ? 'max-w-[460px] flex-[1_1_340px]' : 'max-w-[560px] flex-[1_1_400px]',
              ]}>
              <GuitarPhoto photo={s.photo} sizes="(min-width: 1240px) 520px, (min-width: 900px) 45vw, 100vw" />
            </div>
          )}
          <div class="flex min-w-0 flex-[1_1_460px] flex-col gap-[18px] text-[17px] text-walnut">
            <p class="font-serif text-[24px] text-numeral">{s.numeral}</p>
            <h2 id={`${s.anchor}-title`} class="font-serif text-[clamp(34px,3.6vw,48px)] leading-[1.1] font-normal text-ink">
              {s.title}
            </h2>
            {s.subtitle && <p class="font-serif text-[22px] italic">{s.subtitle}</p>}
            {s.paragraphs.map((p) => (
              <p set:html={inline(p)} />
            ))}
          </div>
          {i % 2 === 1 && (
            <div class="mx-auto min-w-0 max-w-[560px] flex-[1_1_400px]">
              <GuitarPhoto photo={s.photo} sizes="(min-width: 1240px) 520px, (min-width: 900px) 45vw, 100vw" />
            </div>
          )}
        </div>
      </section>
    ))
  }

  <section class="border-t border-rule">
    <div
      class="mx-auto flex max-w-[820px] flex-col items-center gap-[22px] px-[clamp(20px,4vw,48px)] py-[clamp(64px,8vw,112px)] text-center">
      <h2 class="font-serif text-[clamp(36px,4vw,54px)] leading-[1.1] font-normal">{closing.title}</h2>
      <p class="max-w-[34em] text-[18px] text-walnut" set:html={inline(closing.intro)} />
      <ul class="grid w-full grid-cols-1 gap-7 py-4 text-left sm:grid-cols-3">
        {
          sections.map((s) => (
            <li>
              <a
                href={`#${s.anchor}`}
                class="flex h-full flex-col gap-1.5 border-t border-brass pt-3.5 no-underline hover:[&>span:first-child]:underline">
                <span class="font-serif text-[24px] leading-tight text-numeral">
                  {s.numeral} {s.short}
                </span>
                <span class="text-[15px] text-walnut">{s.meaning}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="max-w-[34em] text-[18px] text-walnut" set:html={inline(closing.aspiration)} />
      <blockquote class="max-w-[26em] font-serif text-[clamp(24px,2.6vw,32px)] leading-[1.3] italic">
        <p set:html={inline(closing.quote)} />
      </blockquote>
      <div class="flex flex-wrap justify-center gap-3.5 pt-4">
        <a href="/store" class="btn btn-primary">Explore the collection</a>
        <a href="/" class="btn btn-secondary">Back to home</a>
      </div>
    </div>
  </section>
</BaseLayout>
