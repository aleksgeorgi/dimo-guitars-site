---
import { Image, Picture } from 'astro:assets';
import portrait from '../assets/brand/DimoPortrait.jpg';
import signature from '../assets/brand/DimoSignature_BlackTrimmed.png';
import BaseLayout from '../layouts/BaseLayout.astro';
import GuitarPhoto from '../components/GuitarPhoto.astro';
import { site } from '../data/site';
import { signatures } from '../data/signatures';
import { getPhoto } from '../lib/photos';
import { inline, philosophy } from '../lib/philosophy';

const { title, tagline, intro, about, contributions } = philosophy;

// Numeral, anchor and photo angle come from signatures.ts; title and text from DGPhilosophy.md.
const sections = signatures.map((s, i) => ({
  ...s,
  ...contributions.items[i],
  photo: getPhoto(site.aboutGuitarId, s.angle),
}));

const backgrounds = ['', 'bg-sawdust', ''];
---

<BaseLayout
  title={`Our Philosophy | ${site.name}`}
  description={site.description}
  ogImage={getPhoto(site.aboutGuitarId, 'front').image?.src}>
  <section
    class="mx-auto flex max-w-[820px] flex-col items-center gap-[22px] px-[clamp(20px,4vw,48px)] pt-[clamp(64px,8vw,120px)] pb-[clamp(48px,6vw,80px)] text-center">
    <p class="label">Our philosophy</p>
    <h1 class="font-serif text-[clamp(44px,5.4vw,76px)] leading-[1.04] font-normal">{title}</h1>
    {tagline && <p class="font-serif text-[clamp(22px,2.4vw,30px)] text-walnut italic">{tagline}</p>}
    <span class="my-2 block h-px w-16 bg-brass" aria-hidden="true"></span>
    <div class="flex max-w-[36em] flex-col gap-[18px] text-left text-[18px] text-walnut">
      {intro.map((p) => <p set:html={inline(p)} />)}
    </div>
  </section>

  <section class="bg-sawdust" aria-labelledby="about-title">
    <div class="container-site flex flex-wrap items-center gap-14 py-[clamp(56px,7vw,96px)]">
      <div class="mx-auto min-w-0 max-w-[520px] flex-[1_1_360px]">
        <Picture
          src={portrait}
          alt="Portrait of Dimo, the maker of Dimo Guitars"
          widths={[400, 700, 1000, 1200]}
          sizes="(min-width: 1240px) 520px, (min-width: 900px) 42vw, 100vw"
          formats={['avif']}
          fallbackFormat="webp"
          class="aspect-[4/5] h-auto w-full bg-[#CFCAC2] object-cover"
        />
      </div>
      <div class="flex min-w-0 flex-[1_1_460px] flex-col gap-5">
        <h2 id="about-title" class="heading">{about.title}</h2>
        {about.paragraphs.map((p) => <p class="text-[17px] text-walnut" set:html={inline(p)} />)}
        <Image src={signature} alt="Dimo" width={170} densities={[1, 2]} class="mt-3 h-auto w-[170px]" />
      </div>
    </div>
  </section>

  <section id="contributions" class="scroll-mt-4" aria-labelledby="contributions-title">
    <div
      class="mx-auto flex max-w-[820px] flex-col items-center gap-[22px] px-[clamp(20px,4vw,48px)] pt-[clamp(64px,8vw,112px)] text-center">
      <h2 id="contributions-title" class="font-serif text-[clamp(36px,4vw,54px)] leading-[1.1] font-normal">
        {contributions.title}
      </h2>
      {contributions.intro.map((p) => <p class="max-w-[34em] text-[18px] text-walnut" set:html={inline(p)} />)}
    </div>
  </section>

  {
    sections.map((s, i) => (
      <section id={s.anchor} class:list={['scroll-mt-4', backgrounds[i]]} aria-labelledby={`${s.anchor}-title`}>
        <div
          class:list={[
            'container-site flex items-center gap-16 py-[clamp(56px,7vw,104px)]',
            i % 2 === 1 ? 'flex-wrap-reverse' : 'flex-wrap',
          ]}>
          {i % 2 === 0 && (
            <div
              class:list={[
                'mx-auto min-w-0',
                s.anchor === 'headstock' ? 'max-w-[460px] flex-[1_1_340px]' : 'max-w-[560px] flex-[1_1_400px]',
              ]}>
              <GuitarPhoto photo={s.photo} sizes="(min-width: 1240px) 520px, (min-width: 900px) 45vw, 100vw" />
            </div>
          )}
          <div class="flex min-w-0 flex-[1_1_460px] flex-col gap-[18px] text-[17px] text-walnut">
            <p class="font-serif text-[24px] text-numeral">{s.numeral}</p>
            <h3 id={`${s.anchor}-title`} class="font-serif text-[clamp(34px,3.6vw,48px)] leading-[1.1] font-normal text-ink">
              {s.title}
            </h3>
            {s.subtitle && <p class="font-serif text-[22px] italic">{s.subtitle}</p>}
            {s.paragraphs.map((p) => (
              <p set:html={inline(p)} />
            ))}
          </div>
          {i % 2 === 1 && (
            <div class="mx-auto min-w-0 max-w-[560px] flex-[1_1_400px]">
              <GuitarPhoto photo={s.photo} sizes="(min-width: 1240px) 520px, (min-width: 900px) 45vw, 100vw" />
            </div>
          )}
        </div>
      </section>
    ))
  }

  <section class="border-t border-rule">
    <div class="container-site flex flex-wrap justify-center gap-3.5 py-[clamp(48px,6vw,80px)]">
      <a href="/store" class="btn btn-primary">Explore the collection</a>
      <a href="/" class="btn btn-secondary">Back to home</a>
    </div>
  </section>
</BaseLayout>
