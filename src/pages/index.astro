---
import BaseLayout from '../layouts/BaseLayout.astro';
import GuitarCard from '../components/GuitarCard.astro';
import GuitarPhoto from '../components/GuitarPhoto.astro';
import { models } from '../data/models';
import { site } from '../data/site';
import { signatures } from '../data/signatures';
import { countByModel, featuredGuitars, guitars } from '../lib/inventory';
import { getPhoto } from '../lib/photos';

const featured = featuredGuitars();
const hero = getPhoto(featured[0]?.id ?? site.aboutGuitarId, 'side');
const signatureCards = signatures.map((s) => ({ ...s, photo: getPhoto(site.aboutGuitarId, s.angle) }));

const sectionPad = 'container-site pt-[clamp(64px,8vw,112px)] pb-10';
---

<BaseLayout ogImage={hero.image?.src}>
  <section class="container-site flex flex-wrap items-center gap-14 py-[clamp(48px,7vw,96px)]">
    <div class="flex min-w-0 flex-[1_1_420px] flex-col gap-6">
      <p class="label">Handmade electric guitars · <span class="whitespace-nowrap">{site.location}</span></p>
      <h1 class="display">{site.tagline}</h1>
      <p class="lead max-w-[34em]">{site.description}</p>
      <div class="flex flex-wrap gap-3.5 pt-2">
        <a href="/store" class="btn btn-primary min-h-[50px]">Explore the collection</a>
        <a href="/about" class="btn btn-secondary min-h-[50px]">Our philosophy</a>
      </div>
    </div>
    <div class="min-w-0 flex-[1_1_520px]">
      <GuitarPhoto photo={hero} sizes="(min-width: 1240px) 620px, (min-width: 1000px) 50vw, 100vw" eager />
    </div>
  </section>

  <section class={sectionPad} aria-labelledby="signatures-title">
    <div class="mb-12 flex flex-wrap items-end justify-between gap-6">
      <h2 id="signatures-title" class="heading">Dimo's signature contributions</h2>
      <a href="/about#contributions" class="text-link">Read about them →</a>
    </div>
    <ul class="grid grid-cols-1 gap-10 sm:grid-cols-3 sm:gap-6 lg:gap-10">
      {
        signatureCards.map((s) => (
          <li>
            <a href={`/about#${s.anchor}`} class="group flex flex-col gap-4 text-ink no-underline hover:text-ink">
              <GuitarPhoto
                photo={{ ...s.photo, aspect: '4 / 5' }}
                sizes="(min-width: 1240px) 380px, (min-width: 640px) 30vw, 100vw"
              />
              <p class="font-serif text-[24px] leading-none text-numeral">{s.numeral}</p>
              <h3 class="font-serif text-[24px] leading-[1.15] font-medium group-hover:underline group-hover:underline-offset-4 lg:text-[28px]">
                {s.title}
              </h3>
              <p class="text-walnut">{s.summary}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  {
    featured.length > 0 && (
      <section class={sectionPad} aria-labelledby="featured-title">
        <div class="mb-10 flex flex-wrap items-end justify-between gap-6">
          <div>
            <p class="label mb-2">Fresh from the bench</p>
            <h2 id="featured-title" class="heading">
              Featured instruments
            </h2>
          </div>
          <a href="/store" class="text-link">
            See all {guitars.length} →
          </a>
        </div>
        <ul class="grid grid-cols-2 gap-x-4 gap-y-10 sm:gap-x-7 lg:grid-cols-4">
          {featured.map((g) => (
            <li>
              <GuitarCard guitar={g} />
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section
    id="models"
    class="container-site scroll-mt-4 pt-[clamp(64px,8vw,112px)] pb-[clamp(64px,8vw,112px)]"
    aria-labelledby="models-title">
    <p class="label mb-2">The models</p>
    <h2 id="models-title" class="heading mb-10">Five designs, each one of a kind</h2>
    <ul class="grid grid-cols-[repeat(auto-fit,minmax(200px,1fr))] border-t border-rule">
      {
        models.map((m) => (
          <li class="border-b border-rule">
            <a
              href={`/store?model=${m.code}`}
              class="group flex h-full flex-col gap-2.5 py-7 pr-[22px] text-ink no-underline hover:text-ink">
              <span class="font-serif text-[64px] leading-none font-normal">
                {m.code}
                <span class="sr-only">, {m.fullName}</span>
              </span>
              <span class="text-[14px] text-walnut">Description coming soon.</span>
              <span class="text-[13px] font-medium group-hover:text-navy group-hover:underline">
                {countByModel(m.code)} instruments →
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
