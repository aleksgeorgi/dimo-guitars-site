---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GuitarPhoto from '../../components/GuitarPhoto.astro';
import ModelShowcase from '../../components/ModelShowcase.astro';
import { families, getModel, models } from '../../data/models';
import { site } from '../../data/site';
import { getPhoto } from '../../lib/photos';

const sections = families.map((f) => ({ ...f, models: f.models.map((code) => getModel(code)!) }));
const ogImage = getPhoto(models[0].showcase, 'front').image?.src;

// The strip at the top: one body shot per model, linking down to its section.
const heritage = new Set(families.filter((f) => f.models.length > 1).flatMap((f) => f.models as readonly string[]));
const strip = models.map((m) => ({
  ...m,
  photo: getPhoto(m.showcase, 'frontCrop'),
  body: m.specs.find((spec) => spec.label === 'Body')?.value,
  heritage: heritage.has(m.code),
}));
---

<BaseLayout
  title={`Guitars | Handmade Electric Guitars | ${site.name}`}
  description="The Dimo Guitars models: the D, the M, the R, and their predecessors the RC and the DH. Handmade electric guitars, each one of a kind."
  ogImage={ogImage}>
  <section class="container-site pt-[clamp(48px,6vw,80px)] pb-9">
    <p class="label mb-2.5">The guitars</p>
    <h1 class="mb-4 font-serif text-[clamp(44px,5vw,68px)] leading-[1.04] font-normal">The models</h1>
    <p class="max-w-[36em] text-[17px] text-walnut">
      Four families of handmade electric guitars. Within each one, every instrument is one of a kind.
    </p>
    <nav aria-label="Models" class="mt-9 border-t border-rule pt-7">
      <ul
        class="-mr-[clamp(20px,4vw,48px)] flex snap-x gap-4 overflow-x-auto pr-[clamp(20px,4vw,48px)] pb-3 lg:mr-0 lg:grid lg:grid-cols-5 lg:gap-5 lg:overflow-visible lg:pr-0 lg:pb-0">
        {
          strip.map((m, i) => (
            <li class="w-[40vw] max-w-[230px] shrink-0 snap-start lg:w-auto lg:max-w-none">
              <a href={`#${m.slug}`} class="group flex flex-col gap-3 text-ink no-underline hover:text-ink">
                <GuitarPhoto
                  photo={{ ...m.photo, aspect: '4 / 5' }}
                  sizes="(min-width: 1240px) 215px, (min-width: 1024px) 18vw, 40vw"
                  eager={i < 3}
                />
                <span class="flex flex-col gap-0.5 border-t border-rule pt-3">
                  <span class="font-serif text-[22px] leading-[1.15] font-medium group-hover:underline group-hover:underline-offset-4 sm:text-[24px]">
                    {m.fullName}
                  </span>
                  <span class="text-[13px] text-muted">{[m.body, m.heritage && 'Heritage'].filter(Boolean).join(' · ')}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </section>

  {
    sections.map((f, i) => (
      <section id={f.models.length > 1 ? f.anchor : undefined} class:list={['scroll-mt-4', i % 2 === 1 && 'bg-sawdust']}>
        <div class="container-site py-[clamp(48px,6vw,96px)]">
          {f.models.length === 1 ? (
            <ModelShowcase model={f.models[0]} flip={i % 2 === 1} />
          ) : (
            <>
              <div class="mb-12 max-w-[820px]">
                <p class="label mb-2.5">Heritage</p>
                <h2 class="heading mb-4">{f.title}</h2>
                {f.intro && <p class="max-w-[36em] text-[17px] text-walnut">{f.intro}</p>}
              </div>
              <div class="grid gap-x-12 gap-y-16 md:grid-cols-2">
                {f.models.map((m) => (
                  <ModelShowcase model={m} stacked />
                ))}
              </div>
            </>
          )}
        </div>
      </section>
    ))
  }

  <section class="border-t border-rule">
    <div class="container-site flex flex-wrap justify-center gap-3.5 py-[clamp(48px,6vw,80px)]">
      <a href="/store" class="btn btn-primary">Explore the collection</a>
      <a href="/about" class="btn btn-secondary">Our philosophy</a>
    </div>
  </section>
</BaseLayout>
