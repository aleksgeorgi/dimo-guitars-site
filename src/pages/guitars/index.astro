---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ModelShowcase from '../../components/ModelShowcase.astro';
import ModelStrip from '../../components/ModelStrip.astro';
import { families, getModel, models } from '../../data/models';
import { site } from '../../data/site';
import { sharedSpecs } from '../../lib/inventory';
import { getPhoto } from '../../lib/photos';

const sections = families.map((f) => ({ ...f, models: f.models.map((code) => getModel(code)!) }));
const ogImage = getPhoto(models[0].showcase, 'front').image?.src;

// True of every guitar, listed once at the bottom of the page.
const everyGuitar = [
  { label: 'Pickups', value: sharedSpecs.pickups },
  { label: 'Controls', value: '5-way switch, 1 volume, 1 tone' },
  { label: 'Frets', value: sharedSpecs.frets },
  { label: 'Scale length', value: sharedSpecs.scale },
  { label: 'Fretboard radius', value: sharedSpecs.radius },
  { label: 'Headplate', value: sharedSpecs.headplate },
];
---

<BaseLayout
  title={`Guitars | Handmade Electric Guitars | ${site.name}`}
  description="The Dimo Guitars models: the D, the M, the R, and their predecessors the RC and the DH. Handmade electric guitars, each one of a kind."
  ogImage={ogImage}>
  <section class="container-site pt-[clamp(48px,6vw,80px)] pb-9">
    <p class="label mb-2.5">The guitars</p>
    <h1 class="mb-4 font-serif text-[clamp(44px,5vw,68px)] leading-[1.04] font-normal">The models</h1>
    <p class="max-w-[36em] text-[17px] text-walnut">
      Four families of handmade electric guitars. Within each one, every instrument is one of a kind.
    </p>
    <div class="mt-9 border-t border-rule pt-7">
      <ModelStrip eager />
    </div>
  </section>

  {
    sections.map((f, i) => (
      <section id={f.models.length > 1 ? f.anchor : undefined} class:list={['scroll-mt-4', i % 2 === 1 && 'bg-sawdust']}>
        <div class="container-site py-[clamp(48px,6vw,96px)]">
          {f.models.length === 1 ? (
            <ModelShowcase model={f.models[0]} flip={i % 2 === 1} />
          ) : (
            <>
              <div class="mb-12 max-w-[820px]">
                <p class="label mb-2.5">Heritage</p>
                <h2 class="heading mb-4">{f.title}</h2>
                {f.intro && <p class="max-w-[36em] text-[17px] text-walnut">{f.intro}</p>}
              </div>
              <div class="grid items-start gap-x-12 gap-y-16 md:grid-cols-2">
                {f.models.map((m) => (
                  <ModelShowcase model={m} stacked />
                ))}
              </div>
            </>
          )}
        </div>
      </section>
    ))
  }

  <section class="border-t border-rule" aria-labelledby="every-guitar-title">
    <div class="container-site grid gap-x-16 gap-y-8 py-[clamp(48px,6vw,96px)] lg:grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)]">
      <div>
        <p class="label mb-2.5">Across the models</p>
        <h2 id="every-guitar-title" class="heading">On every Dimo guitar</h2>
      </div>
      <div>
        <dl class="grid grid-cols-[minmax(130px,auto)_1fr] border-t border-rule text-[15px]">
          {
            everyGuitar.map((spec) => (
              <>
                <dt class="border-b border-rule py-3 pr-6 text-muted">{spec.label}</dt>
                <dd class="border-b border-rule py-3">{spec.value}</dd>
              </>
            ))
          }
        </dl>
        <p class="label mt-7 mb-2">The five switch positions</p>
        <ol class="flex list-decimal flex-col gap-1 pl-5 text-[15px]">
          {sharedSpecs.switching.map((position) => <li>{position}</li>)}
        </ol>
      </div>
    </div>
  </section>

  <section class="border-t border-rule">
    <div class="container-site flex flex-wrap justify-center gap-3.5 py-[clamp(48px,6vw,80px)]">
      <a href="/store" class="btn btn-primary">Explore the collection</a>
      <a href="/about" class="btn btn-secondary">Our philosophy</a>
    </div>
  </section>
</BaseLayout>
