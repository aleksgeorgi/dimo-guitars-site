---
// Netlify Forms: detected at deploy from the built HTML. Submissions are emailed
// via a form notification set up in the Netlify dashboard.
import { site } from '../data/site';

const field =
  'min-h-[44px] w-full rounded-[2px] border border-on-navy bg-transparent px-4 py-2.5 text-[15px] text-on-navy placeholder:text-on-navy-muted';
const labelClass = 'mb-1.5 block text-[11px] uppercase tracking-[0.2em] text-on-navy-muted';
---

<section id="contact" class="scroll-mt-4" aria-labelledby="contact-heading">
  <div class="flex flex-wrap gap-x-12 gap-y-6">
    <div class="min-w-0 flex-[1_1_300px]">
      <h2 id="contact-heading" class="mb-4 font-serif text-[40px] leading-[1.1] font-normal">Write to Dimo</h2>
      <p class="max-w-[28em] text-on-navy-soft">
        Have a question about an instrument? Send a note and Dimo will reply personally by email.
      </p>
    </div>

    <form
      name="contact"
      method="POST"
      data-netlify="true"
      netlify-honeypot="company"
      class="grid min-w-0 flex-[999_1_480px] grid-cols-1 gap-4 sm:grid-cols-2"
      data-contact-form>
      <input type="hidden" name="form-name" value="contact" />
      <p class="hidden">
        <label>Leave this field empty <input name="company" tabindex="-1" autocomplete="off" /></label>
      </p>

      <div>
        <label for="contact-email" class={labelClass}>Email</label>
        <input id="contact-email" name="email" type="email" autocomplete="email" required class={field} />
      </div>
      <div>
        <label for="contact-phone" class={labelClass}>Phone <span class="normal-case tracking-normal">(optional)</span></label>
        <input id="contact-phone" name="phone" type="tel" autocomplete="tel" class={field} />
      </div>
      <div class="sm:col-span-2">
        <label for="contact-subject" class={labelClass}>Subject</label>
        <input id="contact-subject" name="subject" type="text" required class={field} />
      </div>
      <div class="sm:col-span-2">
        <label for="contact-message" class={labelClass}>Message</label>
        <textarea id="contact-message" name="message" rows="5" required class:list={[field, 'resize-y']}></textarea>
      </div>
      <div class="flex flex-wrap items-center gap-4 sm:col-span-2">
        <button
          type="submit"
          class="min-h-[44px] cursor-pointer rounded-[2px] bg-on-navy px-6 text-[15px] font-medium text-ink disabled:cursor-wait disabled:opacity-60">
          Send message
        </button>
        <p class="text-[14px] text-on-navy-soft" role="status" data-contact-status></p>
      </div>
    </form>
  </div>
</section>

<script define:vars={{ email: site.email }}>
  const form = document.querySelector('[data-contact-form]');
  const status = form.querySelector('[data-contact-status]');
  const button = form.querySelector('button[type="submit"]');

  document.querySelectorAll('[data-contact-subject]').forEach((link) =>
    link.addEventListener('click', () => {
      form.elements.subject.value = link.dataset.contactSubject;
    }),
  );

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    button.disabled = true;
    status.textContent = 'Sending…';
    try {
      const res = await fetch('/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: new URLSearchParams(new FormData(form)).toString(),
      });
      if (!res.ok) throw new Error(String(res.status));
      form.reset();
      status.textContent = 'Thank you. Your message is on its way, and Dimo will reply by email.';
    } catch {
      status.textContent = `Sorry, your message did not send. Please email ${email} directly.`;
    } finally {
      button.disabled = false;
    }
  });
</script>
