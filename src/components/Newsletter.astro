---
import { site } from '../data/site';

// Paste the EmailOctopus inline form embed here. The free plan allows one form,
// so this component is rendered once per page, in the footer.
const embed = '';
---

<div class="flex min-w-0 flex-[1_1_380px] flex-col gap-4">
  <h2 class="font-serif text-[40px] font-normal leading-[1.1]">Letters from the workshop</h2>
  <p class="text-on-navy-soft">
    Be the first to see new instruments when they leave the bench. A few emails a year, never more.
  </p>

  {
    embed ? (
      <div class="newsletter-embed" set:html={embed} />
    ) : (
      <div class="pt-1.5">
        <a
          href={site.newsletterUrl}
          target="_blank"
          rel="noopener"
          class="inline-flex min-h-[44px] items-center rounded-[2px] bg-on-navy px-6 text-[15px] font-medium text-ink hover:opacity-90">
          Join the mailing list
        </a>
      </div>
    )
  }
</div>
