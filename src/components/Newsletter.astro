---
import { site } from '../data/site';

// Paste the EmailOctopus inline form embed here. The free plan allows one form,
// so this component is rendered once per page, in the footer.
const embed =
  '<script async src="https://eomail6.com/form/d2d1fa9e-db89-11f1-82f5-4d18ff21024a.js" data-form="d2d1fa9e-db89-11f1-82f5-4d18ff21024a"></script>';
---

<div class="flex min-w-0 flex-[1_1_380px] flex-col gap-4">
  <h2 class="font-serif text-[40px] font-normal leading-[1.1]">Letters from the workshop</h2>
  <p class="text-on-navy-soft">
    Be the first to see new instruments when they leave the bench. A few emails a year, never more.
  </p>

  {
    embed ? (
      <div class="newsletter-embed" set:html={embed} />
    ) : (
      <div class="pt-1.5">
        <a
          href={site.newsletterUrl}
          target="_blank"
          rel="noopener"
          class="inline-flex min-h-[44px] items-center rounded-[2px] bg-on-navy px-6 text-[15px] font-medium text-ink hover:opacity-90">
          Join the mailing list
        </a>
      </div>
    )
  }
</div>

<style is:global>
  /* EmailOctopus injects its own styles; these override them to match the contact form. */
  .newsletter-embed [eo-block='title'],
  .newsletter-embed [eo-block='text'],
  .newsletter-embed [eo-block='social-follow'] {
    display: none !important;
  }
  .newsletter-embed [data-form].inline-container[eo-row],
  .newsletter-embed .eo-form-wrapper,
  .newsletter-embed .form-container {
    max-width: none !important;
    margin: 0 !important;
    padding: 0 !important;
    border: 0 !important;
    background: transparent !important;
    box-shadow: none !important;
    font-family: inherit !important;
    color: var(--on-navy) !important;
  }
  .newsletter-embed .main-form {
    display: flex !important;
    flex-wrap: wrap;
    align-items: flex-start !important;
    gap: 10px;
    padding-top: 6px;
  }
  .newsletter-embed [eo-form-fields-container] {
    flex: 1 1 240px;
    min-width: 0;
  }
  .newsletter-embed [data-form] .emailoctopus-form-row,
  .newsletter-embed .emailoctopus-form {
    margin: 0 !important;
  }
  .newsletter-embed .form-control {
    height: 44px !important;
    border: 1px solid var(--on-navy) !important;
    border-radius: 2px !important;
    background: transparent !important;
    color: var(--on-navy) !important;
    font: inherit !important;
    font-size: 15px !important;
    padding: 0 16px !important;
    box-shadow: none !important;
  }
  .newsletter-embed .form-control::placeholder {
    color: var(--on-navy-muted) !important;
  }
  .newsletter-embed .form-control:focus {
    outline: 2px solid var(--on-navy) !important;
    outline-offset: 2px;
  }
  .newsletter-embed input[type='submit'] {
    width: auto !important;
    min-height: 44px;
    margin: 0 !important;
    padding: 0 24px !important;
    border: 0 !important;
    border-radius: 2px !important;
    background: var(--on-navy) !important;
    color: var(--ink) !important;
    font: inherit !important;
    font-size: 15px !important;
    font-weight: 500 !important;
    cursor: pointer;
  }
  .newsletter-embed input[type='submit']:hover {
    opacity: 0.9;
  }
  .newsletter-embed [data-form] .emailoctopus-success-message,
  .newsletter-embed [data-form] .emailoctopus-error-message {
    margin: 0 0 12px !important;
    font-family: inherit !important;
    font-size: 15px !important;
    color: var(--on-navy) !important;
  }
  .newsletter-embed [data-form] .emailoctopus-error-message {
    color: #f3c6b4 !important;
  }
  .newsletter-embed [data-form] .text-center,
  .newsletter-embed [data-form] [eo-block='powered-by'],
  .newsletter-embed [data-form] [eo-block='powered-by'] .inner,
  .newsletter-embed [data-form] [eo-block='powered-by'] p {
    margin: 0 !important;
    padding: 0 !important;
    text-align: left !important;
  }
  .newsletter-embed [data-form] [eo-block='powered-by'] p,
  .newsletter-embed [data-form] [eo-block='powered-by'] a {
    margin-top: 12px !important;
    font-family: inherit !important;
    font-size: 12px !important;
    color: var(--on-navy-muted) !important;
  }
  /* The badge is a purple SVG background; render it as a soft light tone on navy. */
  .newsletter-embed [data-form] [eo-block='powered-by'] p {
    background-position: left center !important;
    filter: brightness(0) invert(1);
    opacity: 0.7;
  }
</style>

<script is:inline>
  // EmailOctopus hides the form and shows its own one-line message. Add a prompt to
  // confirm the signup, since the confirmation email can land in spam.
  document.addEventListener('emailoctopus:form.success', () => {
    const message = document.querySelector('.emailoctopus-success-message');
    if (!message || message.querySelector('span')) return;
    const hint = document.createElement('span');
    hint.className = 'mt-1.5 block text-[14px] text-on-navy-soft';
    hint.textContent =
      'Please check your email to confirm your signup. If you don\u2019t see it, look in your spam folder and mark it \u201cNot spam\u201d.';
    message.append(hint);
  });
</script>
