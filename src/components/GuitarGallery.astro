---
import { Picture } from 'astro:assets';
import { widthsFor, type Photo } from '../lib/photos';

type Props = { photos: Photo[]; name: string };
const { photos, name } = Astro.props;

const main = photos[0];
const viewable = photos.filter((p) => p.image);
const slideIndex = (p: Photo) => viewable.indexOf(p);
const fill = 'absolute inset-0 h-full w-full object-contain';
---

<div class="flex min-w-0 flex-col gap-3.5">
  {
    main.image ? (
      <button
        type="button"
        data-lightbox-open="0"
        aria-label={`Enlarge photo: ${main.label}`}
        class="group relative block max-h-[860px] w-full cursor-zoom-in overflow-hidden bg-photo"
        style={`aspect-ratio: ${main.aspect}`}>
        <Picture
          src={main.image}
          alt={main.alt}
          widths={widthsFor(main.image, [480, 720, 1000, 1400])}
          sizes="(min-width: 1240px) 690px, (min-width: 1024px) 55vw, 100vw"
          formats={['avif']}
          fallbackFormat="webp"
          loading="eager"
          fetchpriority="high"
          class={fill}
        />
        <span class="absolute bottom-3 left-4 text-[12px] text-muted opacity-0 transition-opacity duration-200 group-hover:opacity-100 group-focus-visible:opacity-100">
          Click to enlarge
        </span>
      </button>
    ) : (
      <div class="max-h-[860px] w-full bg-photo" style={`aspect-ratio: ${main.aspect}`} />
    )
  }

  <ul class="grid grid-cols-6 items-end gap-2 sm:gap-2.5" aria-label="Photos">
    {
      photos.map((p, i) => (
        <li>
          {p.image ? (
            <button
              type="button"
              data-lightbox-open={slideIndex(p)}
              aria-label={`View larger: ${p.label}`}
              class:list={[
                'relative block w-full cursor-zoom-in overflow-hidden bg-photo',
                i === 0 ? 'border-2 border-ink' : 'border border-rule hover:border-ink',
              ]}
              style={`aspect-ratio: ${p.aspect}`}>
              <Picture
                src={p.image}
                alt=""
                widths={widthsFor(p.image, [120, 240])}
                sizes="(min-width: 1240px) 110px, 16vw"
                formats={['avif']}
          fallbackFormat="webp"
                loading="lazy"
                class={fill}
              />
            </button>
          ) : (
            <div class="w-full border border-rule bg-photo" style={`aspect-ratio: ${p.aspect}`} />
          )}
        </li>
      ))
    }
  </ul>
</div>

{
  viewable.length > 0 && (
    <dialog
      data-lightbox
      aria-label={`${name} photos`}
      class="lightbox fixed inset-0 m-0 h-dvh max-h-none w-full max-w-none flex-col bg-photo p-0 text-ink open:flex">
      <div class="flex items-center justify-between gap-4 px-[clamp(16px,3vw,32px)] py-3">
        <p class="text-[13px] text-muted" aria-live="polite">
          <span data-lightbox-counter>1 / {viewable.length}</span>
          <span class="mx-1.5" aria-hidden="true">·</span>
          <span data-lightbox-caption>{viewable[0].label}</span>
        </p>
        <button
          type="button"
          data-lightbox-close
          autofocus
          class="-mr-2 inline-flex h-11 w-11 cursor-pointer items-center justify-center">
          <span class="sr-only">Close</span>
          <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M5 5l14 14M19 5L5 19" />
          </svg>
        </button>
      </div>

      <div class="relative min-h-0 flex-1" data-lightbox-stage>
        {viewable.map((p, i) => (
          <figure data-lightbox-slide data-label={p.label} hidden={i !== 0} class="absolute inset-0 m-0 px-[clamp(8px,6vw,88px)] pb-6">
            <Picture
              src={p.image!}
              alt={p.alt}
              widths={widthsFor(p.image!, [800, 1200, 1600])}
              sizes="100vw"
              formats={['avif']}
          fallbackFormat="webp"
              loading="lazy"
              pictureAttributes={{ class: 'block h-full w-full' }}
              class="h-full w-full object-contain"
            />
          </figure>
        ))}

        {viewable.length > 1 && (
          <>
            <button
              type="button"
              data-lightbox-prev
              class="absolute top-1/2 left-1 inline-flex h-12 w-12 -translate-y-1/2 cursor-pointer items-center justify-center sm:left-4">
              <span class="sr-only">Previous photo</span>
              <svg aria-hidden="true" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25">
                <path d="M15 4l-8 8 8 8" />
              </svg>
            </button>
            <button
              type="button"
              data-lightbox-next
              class="absolute top-1/2 right-1 inline-flex h-12 w-12 -translate-y-1/2 cursor-pointer items-center justify-center sm:right-4">
              <span class="sr-only">Next photo</span>
              <svg aria-hidden="true" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25">
                <path d="M9 4l8 8-8 8" />
              </svg>
            </button>
          </>
        )}
      </div>
    </dialog>
  )
}

<style>
  .lightbox[open] {
    animation: lightbox-fade 200ms ease-out;
  }

  .lightbox::backdrop {
    background: transparent;
  }

  @keyframes lightbox-fade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');

  if (dialog) {
    const slides = [...dialog.querySelectorAll<HTMLElement>('[data-lightbox-slide]')];
    const counter = dialog.querySelector<HTMLElement>('[data-lightbox-counter]')!;
    const caption = dialog.querySelector<HTMLElement>('[data-lightbox-caption]')!;
    const stage = dialog.querySelector<HTMLElement>('[data-lightbox-stage]')!;
    let index = 0;

    const show = (i: number) => {
      index = (i + slides.length) % slides.length;
      slides.forEach((slide, j) => (slide.hidden = j !== index));
      counter.textContent = `${index + 1} / ${slides.length}`;
      caption.textContent = slides[index].dataset.label ?? '';
    };

    document.querySelectorAll<HTMLButtonElement>('[data-lightbox-open]').forEach((button) => {
      button.addEventListener('click', () => {
        show(Number(button.dataset.lightboxOpen));
        dialog.showModal();
        document.documentElement.style.overflow = 'hidden';
      });
    });

    dialog.addEventListener('close', () => {
      document.documentElement.style.overflow = '';
    });

    dialog.querySelector('[data-lightbox-close]')?.addEventListener('click', () => dialog.close());
    dialog.querySelector('[data-lightbox-prev]')?.addEventListener('click', () => show(index - 1));
    dialog.querySelector('[data-lightbox-next]')?.addEventListener('click', () => show(index + 1));

    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(index - 1);
      else if (e.key === 'ArrowRight') show(index + 1);
      else if (e.key === 'Escape') dialog.close();
      else return;
      e.preventDefault();
    });

    let startX = 0;
    let startY = 0;
    stage.addEventListener(
      'touchstart',
      (e) => {
        startX = e.touches[0].clientX;
        startY = e.touches[0].clientY;
      },
      { passive: true },
    );
    stage.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - startX;
      const dy = e.changedTouches[0].clientY - startY;
      if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) show(index + (dx < 0 ? 1 : -1));
    });
  }
</script>
