---
import { Picture } from 'astro:assets';
import Lightbox from './Lightbox.astro';
import { widthsFor, type Photo } from '../lib/photos';

type Props = { photos: Photo[]; name: string };
const { photos, name } = Astro.props;

const main = photos[0];
const viewable = photos.filter((p) => p.image);
const slideIndex = (p: Photo) => viewable.indexOf(p);
const fill = 'absolute inset-0 h-full w-full object-contain';
---

<div class="flex min-w-0 flex-col gap-3.5">
  {
    main.image ? (
      <button
        type="button"
        data-lightbox-open="0"
        data-lightbox-group="gallery"
        aria-label={`Enlarge photo: ${main.label}`}
        class="group relative block max-h-[860px] w-full cursor-zoom-in overflow-hidden bg-photo"
        style={`aspect-ratio: ${main.aspect}`}>
        <Picture
          src={main.image}
          alt={main.alt}
          widths={widthsFor(main.image, [480, 720, 1000, 1400])}
          sizes="(min-width: 1240px) 690px, (min-width: 1024px) 55vw, 100vw"
          formats={['avif']}
          fallbackFormat="webp"
          loading="eager"
          fetchpriority="high"
          class={fill}
        />
        <span class="absolute bottom-3 left-4 text-[12px] text-muted opacity-0 transition-opacity duration-200 group-hover:opacity-100 group-focus-visible:opacity-100">
          Click to enlarge
        </span>
      </button>
    ) : (
      <div class="max-h-[860px] w-full bg-photo" style={`aspect-ratio: ${main.aspect}`} />
    )
  }

  <ul class="grid grid-cols-6 items-end gap-2 sm:gap-2.5" aria-label="Photos">
    {
      photos.map((p, i) => (
        <li>
          {p.image ? (
            <button
              type="button"
              data-lightbox-open={slideIndex(p)}
              data-lightbox-group="gallery"
              aria-label={`View larger: ${p.label}`}
              class:list={[
                'relative block w-full cursor-zoom-in overflow-hidden bg-photo',
                i === 0 ? 'border-2 border-ink' : 'border border-rule hover:border-ink',
              ]}
              style={`aspect-ratio: ${p.aspect}`}>
              <Picture
                src={p.image}
                alt=""
                widths={widthsFor(p.image, [120, 240])}
                sizes="(min-width: 1240px) 110px, 16vw"
                formats={['avif']}
          fallbackFormat="webp"
                loading="lazy"
                class={fill}
              />
            </button>
          ) : (
            <div class="w-full border border-rule bg-photo" style={`aspect-ratio: ${p.aspect}`} />
          )}
        </li>
      ))
    }
  </ul>
</div>

<Lightbox photos={photos} name={name} group="gallery" />
