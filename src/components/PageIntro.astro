---
type Props = { label?: string; title: string; centered?: boolean };
const { label, title, centered = false } = Astro.props;
---

<section class="container-site py-[clamp(48px,7vw,96px)]">
  <div class:list={['flex max-w-[820px] flex-col gap-6', centered && 'mx-auto items-center text-center']}>
    {label && <p class="label">{label}</p>}
    <h1 class="display">{title}</h1>
    <slot />
  </div>
</section>
