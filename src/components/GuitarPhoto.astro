---
import { Picture } from 'astro:assets';
import { widthsFor, type Photo } from '../lib/photos';

type Props = {
  photo: Photo;
  sizes: string;
  eager?: boolean;
  class?: string;
  // When set, the photo is a button that opens this group's <Lightbox> at this photo.
  lightbox?: { group: string; index: number };
};

const { photo, sizes, eager = false, class: className, lightbox } = Astro.props;
const zoomable = lightbox && photo.image;
const Tag = zoomable ? 'button' : 'div';
const attrs = zoomable
  ? {
      type: 'button',
      'data-lightbox-open': lightbox.index,
      'data-lightbox-group': lightbox.group,
      'aria-label': `View larger: ${photo.label}`,
    }
  : {};
---

<Tag
  {...attrs}
  class:list={['relative block w-full overflow-hidden bg-photo', zoomable && 'cursor-zoom-in', className]}
  style={`aspect-ratio: ${photo.aspect}`}>
  {
    photo.image && (
      <Picture
        src={photo.image}
        alt={photo.alt}
        formats={['avif']}
        fallbackFormat="webp"
        widths={widthsFor(photo.image, [400, 700, 1000, 1400])}
        sizes={sizes}
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : undefined}
        class="h-full w-full object-contain"
      />
    )
  }
</Tag>
