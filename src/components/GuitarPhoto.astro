---
import { Picture } from 'astro:assets';
import { widthsFor, type Photo } from '../lib/photos';

type Props = {
  photo: Photo;
  sizes: string;
  eager?: boolean;
  class?: string;
};

const { photo, sizes, eager = false, class: className } = Astro.props;
---

<div class:list={['relative overflow-hidden bg-photo', className]} style={`aspect-ratio: ${photo.aspect}`}>
  {
    photo.image && (
      <Picture
        src={photo.image}
        alt={photo.alt}
        formats={['avif']}
        fallbackFormat="webp"
        widths={widthsFor(photo.image, [400, 700, 1000, 1400])}
        sizes={sizes}
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : undefined}
        class="h-full w-full object-contain"
      />
    )
  }
</div>
