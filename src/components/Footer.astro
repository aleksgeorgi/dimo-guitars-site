---
import ContactForm from './ContactForm.astro';
import Newsletter from './Newsletter.astro';
import { navPages, site } from '../data/site';

const social = site.social.filter((s) => s.href);
const year = new Date().getFullYear();
---

<footer id="newsletter" class="on-navy scroll-mt-4 bg-navy text-on-navy">
  <div class="container-site flex flex-wrap justify-between gap-12 pt-[clamp(56px,7vw,88px)] pb-10">
    <Newsletter />

    <div class="flex flex-wrap gap-12 text-[14px]">
      <div class="flex flex-col gap-2.5">
        <span class="text-[11px] uppercase tracking-[0.2em] text-on-navy-muted">Explore</span>
        {
          navPages.map((p) => (
            <a href={p.href} class="text-on-navy no-underline hover:text-on-navy hover:underline">
              {p.label}
            </a>
          ))
        }
      </div>
      <div class="flex flex-col gap-2.5">
        <span class="text-[11px] uppercase tracking-[0.2em] text-on-navy-muted">Contact</span>
        <a href={`mailto:${site.email}`} class="text-on-navy no-underline hover:text-on-navy hover:underline">
          {site.email}
        </a>
        <span>{site.location}</span>
        {
          social.length > 0 && (
            <span>
              {social.map((s, i) => (
                <>
                  {i > 0 && ' · '}
                  <a href={s.href} class="text-on-navy no-underline hover:text-on-navy hover:underline" rel="noopener">
                    {s.label}
                  </a>
                </>
              ))}
            </span>
          )
        }
      </div>
    </div>
  </div>

  <div class="container-site">
    <div class="border-t border-on-navy/20 pt-[clamp(48px,6vw,72px)] pb-14">
      <ContactForm />
    </div>
  </div>

  <div
    class="container-site flex flex-wrap justify-between gap-3 border-t border-on-navy/20 pt-5 pb-8 text-[13px] text-on-navy-muted">
    <span>© {year} {site.name} · {site.tagline}</span>
    <a href="/privacy" class="text-on-navy-muted hover:text-on-navy">Privacy</a>
  </div>
</footer>
