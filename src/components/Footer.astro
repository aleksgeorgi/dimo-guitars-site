---
import ContactForm from './ContactForm.astro';
import Newsletter from './Newsletter.astro';
import { navPages, site } from '../data/site';

// Outline icons drawn on a 24px grid, keyed by the labels in site.social.
const icons: Record<string, string> = {
  Instagram:
    '<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.3" cy="6.7" r="0.6" fill="currentColor"/>',
  YouTube:
    '<rect x="2.5" y="5.5" width="19" height="13" rx="4"/><path d="M10.2 9.3v5.4l4.6-2.7z" fill="currentColor"/>',
  Facebook:
    '<circle cx="12" cy="12" r="9.5"/><path d="M13.2 21.3v-8h2.5l.4-2.9h-2.9V8.9c0-.9.3-1.5 1.5-1.5h1.5V4.9c-.4-.1-1.2-.2-2.1-.2-2.2 0-3.6 1.3-3.6 3.8v1.9H8.2v2.9h2.3v8"/>',
};

const social = site.social.filter((s) => s.href && icons[s.label]);
const year = new Date().getFullYear();
---

<footer id="newsletter" class="on-navy scroll-mt-4 bg-navy text-on-navy">
  <div class="container-site flex flex-wrap justify-between gap-12 pt-[clamp(56px,7vw,88px)] pb-10">
    <Newsletter />

    <div class="flex flex-wrap gap-12 text-[14px]">
      <div class="flex flex-col gap-2.5">
        <span class="text-[11px] uppercase tracking-[0.2em] text-on-navy-muted">Explore</span>
        {
          navPages.map((p) => (
            <a href={p.href} class="text-on-navy no-underline hover:text-on-navy hover:underline">
              {p.label}
            </a>
          ))
        }
      </div>
      <div class="flex flex-col gap-2.5">
        <span class="text-[11px] uppercase tracking-[0.2em] text-on-navy-muted">Contact</span>
        <a href={`mailto:${site.email}`} class="text-on-navy no-underline hover:text-on-navy hover:underline">
          {site.email}
        </a>
        <span>{site.location}</span>
        {
          social.length > 0 && (
            <ul class="-ml-2.5 flex">
              {social.map((s) => (
                <li>
                  <a
                    href={s.href}
                    aria-label={`Dimo Guitars on ${s.label}`}
                    title={s.label}
                    class="inline-flex h-11 w-11 items-center justify-center text-on-navy transition-opacity duration-200 hover:text-on-navy hover:opacity-70"
                    target="_blank"
                    rel="noopener">
                    <svg
                      aria-hidden="true"
                      width="26"
                      height="26"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      set:html={icons[s.label]}
                    />
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </div>
  </div>

  <div class="container-site">
    <div class="border-t border-on-navy/20 pt-[clamp(48px,6vw,72px)] pb-14">
      <ContactForm />
    </div>
  </div>

  <div
    class="container-site flex flex-wrap justify-between gap-3 border-t border-on-navy/20 pt-5 pb-8 text-[13px] text-on-navy-muted">
    <span>© {year} {site.name} · {site.tagline}</span>
    <a href="/privacy" class="text-on-navy-muted hover:text-on-navy">Privacy</a>
  </div>
</footer>
