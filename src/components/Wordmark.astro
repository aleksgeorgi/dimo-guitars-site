---
import { Image } from 'astro:assets';
import signature from '../assets/brand/DimoSignature_BlackTrimmed.png';

type Props = { size?: 'header' | 'menu' };
const { size = 'header' } = Astro.props;
---

<a href="/" class="flex items-center gap-3 text-ink no-underline hover:text-ink" aria-label="Dimo Guitars, home">
  <Image
    src={signature}
    alt=""
    width={140}
    densities={[1, 2, 3]}
    loading="eager"
    class:list={['h-auto', size === 'header' ? 'w-[112px] sm:w-[140px]' : 'w-[112px]']}
  />
  <span class="pt-1 text-[12px] font-medium uppercase tracking-[0.32em]">Guitars</span>
</a>
